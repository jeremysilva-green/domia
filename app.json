{
  "expo": {
    "name": "Domia",
    "slug": "domus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Domia app icon.png",
    "scheme": "domus",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Domia Splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.domia.propertyapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Domia app icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.domia.propertyapp",
      "versionCode": 27,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#1a1a2e",
          "sounds": [
            "./assets/snd_due_date.mp3",
            "./assets/snd_passed_due.mp3",
            "./assets/snd_notification.mp3",
            "./assets/snd_paid.mp3",
            "./assets/snd_request.mp3"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Domus to access your photos for maintenance requests.",
          "cameraPermission": false
        }
      ],
      "expo-localization",
      "react-native-iap",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a116f40-1165-4ef4-b408-4ba19f4b246e"
      }
    }
  }
}
